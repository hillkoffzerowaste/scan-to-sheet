{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "site": "hillkoff-twin-oganization",
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/:path*",
        "destination": "https://scan-to-sheet--hillkoff-twin-oganization.asia-southeast1.hosted.app/:path",
        "type": 301
      }
    ]
  }
}
