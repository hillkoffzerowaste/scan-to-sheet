rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isStaffAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/adminUsers/$(request.auth.uid));
    }

    function staffExists(staffId) {
      return exists(/databases/$(database)/documents/staffMembers/$(staffId));
    }

    match /adminUsers/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    match /staffMembers/{staffId} {
      allow read: if isSignedIn();
      allow create, update: if isStaffAdmin()
        && request.resource.data.fullName is string
        && request.resource.data.employeeId is string
        && request.resource.data.employeeId.size() <= 60
        && request.resource.data.nickname is string
        && request.resource.data.position in ['leader', 'checker', 'packer']
        && request.resource.data.active is bool;
      allow delete: if false;
    }

    match /staffEmployeeCodes/{employeeCode} {
      allow read: if isStaffAdmin();
      allow create, update: if isStaffAdmin()
        && request.resource.data.staffId is string
        && request.resource.data.employeeId is string;
      allow delete: if isStaffAdmin();
    }

    match /staffPrivateNotes/{staffId} {
      allow read, create, update: if isStaffAdmin();
      allow delete: if false;
    }

    match /staffPrivateContacts/{staffId} {
      allow read: if isStaffAdmin();
      allow create, update: if isStaffAdmin()
        && request.resource.data.phone is string
        && request.resource.data.lineId is string
        && request.resource.data.email is string
        && request.resource.data.updatedByUid == request.auth.uid;
      allow delete: if false;
    }

    match /staffSettings/packingRoomNotice {
      allow read: if isSignedIn();
      allow create, update: if isStaffAdmin()
        && request.resource.data.keys().hasOnly(['content', 'updatedAt', 'updatedByUid'])
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 5000
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedByUid == request.auth.uid;
      allow delete: if false;
    }

    match /staffDutyTypes/{dutyTypeId} {
      allow read: if isSignedIn();
      allow create, update: if isStaffAdmin()
        && request.resource.data.name is string
        && request.resource.data.active is bool;
      allow delete: if false;
    }

    // เวรประจำสัปดาห์ — ตารางตายตัวที่ทุกวันในสัปดาห์ยึดตาม
    match /staffWeeklyDuties/{weeklyDutyId} {
      allow read: if isSignedIn();
      allow create, update: if isStaffAdmin()
        && request.resource.data.keys().hasOnly([
          'weekday', 'staffId', 'dutyTypeId', 'note', 'updatedAt', 'updatedBy'
        ])
        && request.resource.data.weekday is int
        && request.resource.data.weekday >= 0
        && request.resource.data.weekday <= 6
        && request.resource.data.staffId is string
        && staffExists(request.resource.data.staffId)
        && request.resource.data.dutyTypeId is string
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 200;
      allow delete: if isStaffAdmin();
    }

    // การเปลี่ยนแปลงเฉพาะวัน — ผูกกับวันที่ ไม่แตะตารางเวรประจำ
    // staffId เป็นสตริงว่างได้ หมายถึงงดเวรนั้นเฉพาะวันนั้น
    match /staffDutyOverrides/{overrideId} {
      allow read: if isSignedIn();
      allow create, update: if isStaffAdmin()
        && request.resource.data.keys().hasOnly([
          'date', 'weeklyDutyId', 'staffId', 'note', 'updatedAt', 'updatedByUid'
        ])
        && request.resource.data.date is string
        && request.resource.data.date.size() == 10
        && request.resource.data.weeklyDutyId is string
        && overrideId == request.resource.data.date + '__' + request.resource.data.weeklyDutyId
        && request.resource.data.staffId is string
        // สตริงว่าง = งดเวรวันนั้น จึงต้องยกเว้นจากการตรวจว่ามีพนักงานจริง
        && (request.resource.data.staffId == ''
            || staffExists(request.resource.data.staffId))
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 200
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedByUid == request.auth.uid;
      allow delete: if isStaffAdmin();
    }

    match /staffDailyAssignments/{assignmentId} {
      allow read: if isSignedIn();
      allow create, update: if isStaffAdmin()
        && request.resource.data.date is string
        && request.resource.data.staffId is string
        && request.resource.data.dutyTypeId is string;
      allow delete: if isStaffAdmin();
    }

    match /staffDailyStatuses/{statusId} {
      allow read: if isSignedIn();
      allow create, update: if isStaffAdmin()
        && request.resource.data.keys().hasOnly([
          'date', 'staffId', 'status', 'updatedAt', 'updatedByUid'
        ])
        && request.resource.data.date is string
        && request.resource.data.date.size() == 10
        && request.resource.data.staffId is string
        && request.resource.data.status in ['leave', 'off', 'outside']
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedByUid == request.auth.uid;
      allow delete: if isStaffAdmin();
    }

    match /staffDailyLeads/{date} {
      allow read: if isSignedIn();
      allow create, update: if isStaffAdmin()
        && request.resource.data.keys().hasOnly([
          'date', 'staffId', 'updatedAt', 'updatedByUid'
        ])
        && request.resource.data.date == date
        && request.resource.data.date.size() == 10
        && request.resource.data.staffId is string
        && get(/databases/$(database)/documents/staffMembers/$(request.resource.data.staffId)).data.position in ['checker', 'packer']
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedByUid == request.auth.uid;
      allow delete: if isStaffAdmin();
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.uid == request.auth.uid;
    }

    match /scanEvents/{eventId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.code is string
        && request.resource.data.courier is string
        && request.resource.data.type in ['packer', 'admin'];
      allow update, delete: if false;
    }

    match /orders/{orderId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn()
        && request.resource.data.code is string
        && request.resource.data.normalizedCode is string
        && request.resource.data.courier is string
        && request.resource.data.date is string
        && request.resource.data.status in [
          'pending',
          'packer_scanned',
          'matched',
          'issue',
          'cancelled',
          'damaged',
          'returned'
        ]
        && request.resource.data.sheetSyncStatus in [
          'pending',
          'synced',
          'failed'
        ];
      allow delete: if false;
      allow update: if isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'marketplaceOrderId', 'marketplaceSkus', 'marketplaceItems'
        ])
        && request.resource.data.marketplaceOrderId is string
        && request.resource.data.marketplaceSkus is list
        && request.resource.data.marketplaceSkus.size() <= 100
        && request.resource.data.marketplaceItems is list
        && request.resource.data.marketplaceItems.size() <= 100;
    }

    match /marketplaceOrders/{orderId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly([
          'platform', 'orderId', 'trackingNo', 'normalizedTrackingNo',
          'marketplaceSkus', 'items', 'sourceRowCount', 'sellerOrderStatus', 'expectedShipAt',
          'importSource', 'importedAt', 'updatedAt'
        ])
        && request.resource.data.platform in ['shopee', 'lazada', 'tiktok']
        && request.resource.data.orderId is string
        && request.resource.data.trackingNo is string
        && request.resource.data.normalizedTrackingNo is string
        && request.resource.data.marketplaceSkus is list
        && request.resource.data.marketplaceSkus.size() <= 100
        && request.resource.data.items is list
        && request.resource.data.items.size() <= 100
        && request.resource.data.sourceRowCount is int
        && request.resource.data.sourceRowCount >= 0
        && request.resource.data.sourceRowCount <= 10000
        && request.resource.data.sellerOrderStatus is string
        && request.resource.data.expectedShipAt is string
        && request.resource.data.importSource == 'web_upload'
        && request.resource.data.importedAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.platform + '__' + request.resource.data.orderId == orderId;
      allow update: if isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'platform', 'orderId', 'trackingNo', 'normalizedTrackingNo',
          'marketplaceSkus', 'items', 'sourceRowCount', 'sellerOrderStatus', 'expectedShipAt',
          'importSource', 'importedAt', 'updatedAt'
        ])
        && request.resource.data.platform in ['shopee', 'lazada', 'tiktok']
        && request.resource.data.orderId is string
        && request.resource.data.trackingNo is string
        && request.resource.data.normalizedTrackingNo is string
        && request.resource.data.marketplaceSkus is list
        && request.resource.data.marketplaceSkus.size() <= 100
        && request.resource.data.items is list
        && request.resource.data.items.size() <= 100
        && request.resource.data.sourceRowCount is int
        && request.resource.data.sourceRowCount >= 0
        && request.resource.data.sourceRowCount <= 10000
        && request.resource.data.sellerOrderStatus is string
        && request.resource.data.expectedShipAt is string
        && request.resource.data.importSource == 'web_upload'
        && request.resource.data.importedAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.platform + '__' + request.resource.data.orderId == orderId;
      allow delete: if false;
    }

    // Packing videos are evidence for customer disputes, so nobody deletes them — not the
    // packer, not an Admin. "Cancelled" is a status, not a removal. The field list mirrors
    // PACKING_VIDEO_FIELDS in src/services/packingVideoModel.js; the Drive worker runs on
    // firebase-admin and bypasses these rules, so it must write the same keys or every later
    // client update fails this hasOnly() check.
    function packingVideoFields() {
      return [
        'videoId', 'trackingNo', 'normalizedTrackingNo', 'attemptNo', 'orderId', 'platform',
        'marketplaceOrderDocId', 'packer', 'packerStaffId', 'stationId', 'deviceId', 'sessionId',
        'startedAt', 'finishedAt', 'durationMs', 'bangkokDate', 'status', 'mimeType', 'sizeBytes',
        'storagePath', 'storageUrl', 'uploadedAt', 'uploadAttempts', 'lastErrorCode',
        'sheetStatus', 'sheetRowNumber', 'driveStatus', 'driveFileId', 'driveUrl',
        'movedToDriveAt', 'note', 'createdByUid', 'createdByEmail', 'updatedAt'
      ];
    }

    match /packingVideos/{videoId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(packingVideoFields())
        && request.resource.data.videoId == videoId
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.trackingNo is string
        && request.resource.data.normalizedTrackingNo is string
        && request.resource.data.attemptNo is int
        && request.resource.data.attemptNo >= 1
        && request.resource.data.attemptNo <= 100
        && request.resource.data.durationMs is int
        && request.resource.data.durationMs >= 0
        && request.resource.data.durationMs <= 7200000
        && request.resource.data.sizeBytes is int
        && request.resource.data.sizeBytes >= 0
        && request.resource.data.sizeBytes <= 524288000
        && request.resource.data.bangkokDate is string
        && request.resource.data.bangkokDate.size() == 10
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 500
        && request.resource.data.status in ['pending_upload', 'cancelled', 'needs_review']
        && request.resource.data.sheetStatus == 'pending'
        && request.resource.data.driveStatus == 'pending';

      // Uploader lane: the packer who recorded the clip may only move it along the upload path.
      allow update: if isSignedIn()
        && resource.data.createdByUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'storageUrl', 'storagePath', 'uploadedAt', 'uploadAttempts',
          'lastErrorCode', 'sizeBytes', 'sheetStatus', 'sheetRowNumber', 'updatedAt'
        ])
        && request.resource.data.status in [
          'pending_upload', 'uploaded', 'upload_failed', 'cancelled', 'needs_review'
        ]
        && request.resource.data.sizeBytes is int
        && request.resource.data.sizeBytes <= 524288000;

      // Admin lane: fix a note or a status by hand, and record where the file ended up.
      allow update: if isStaffAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'note', 'driveStatus', 'driveFileId', 'driveUrl', 'movedToDriveAt',
          'sheetStatus', 'sheetRowNumber', 'updatedAt'
        ])
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 500
        && request.resource.data.status in [
          'pending_upload', 'uploaded', 'upload_failed', 'cancelled', 'needs_review'
        ];

      allow delete: if false;
    }

    // Reserves the attempt number for a tracking number. The +1 check is the server-side half
    // of the client transaction: even a buggy or racing client cannot skip or reuse a number.
    match /packingVideoTracking/{tracking} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly([
          'normalizedTrackingNo', 'lastAttemptNo', 'lastVideoId', 'updatedAt'
        ])
        && request.resource.data.normalizedTrackingNo == tracking
        && request.resource.data.lastAttemptNo == 1
        && request.resource.data.lastVideoId is string;
      allow update: if isSignedIn()
        && request.resource.data.keys().hasOnly([
          'normalizedTrackingNo', 'lastAttemptNo', 'lastVideoId', 'updatedAt'
        ])
        && request.resource.data.normalizedTrackingNo == tracking
        && request.resource.data.lastAttemptNo == resource.data.lastAttemptNo + 1
        && request.resource.data.lastAttemptNo <= 100
        && request.resource.data.lastVideoId is string;
      allow delete: if false;
    }

    // Append-only, like scanEvents. Packers cannot read it: knowing who reviewed which clip is
    // an Admin concern, and a writable audit trail would not be one.
    match /packingVideoAudit/{eventId} {
      allow read: if isStaffAdmin();
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly([
          'videoId', 'action', 'actorUid', 'actorEmail', 'at', 'deviceId', 'detail'
        ])
        && request.resource.data.videoId is string
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.at == request.time
        && request.resource.data.action in [
          'view', 'download', 'status_change', 'note_change',
          'drive_moved', 'sheet_written', 'delete_request'
        ];
      allow update, delete: if false;
    }

    match /syncStatus/{platform} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /couriers/{courierId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80;
      allow delete: if false;
    }
  }
}
