rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isStaffAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/adminUsers/$(request.auth.uid));
    }

    // This claim is minted only by trusted Firebase Admin tooling. A Firebase login alone is
    // not warehouse membership: every operational collection below requires this boundary.
    function isOperationalStaff() {
      return isSignedIn() && (
        request.auth.token.operator == true
        || exists(/databases/$(database)/documents/adminUsers/$(request.auth.uid))
      );
    }

    function staffExists(staffId) {
      return exists(/databases/$(database)/documents/staffMembers/$(staffId));
    }

    match /adminUsers/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    match /staffMembers/{staffId} {
      allow read: if isOperationalStaff();
      allow create, update: if isStaffAdmin()
        && request.resource.data.fullName is string
        && request.resource.data.employeeId is string
        && request.resource.data.employeeId.size() <= 60
        && request.resource.data.nickname is string
        && request.resource.data.position in ['leader', 'checker', 'packer']
        && request.resource.data.active is bool;
      allow delete: if false;
    }

    match /staffEmployeeCodes/{employeeCode} {
      allow read: if isStaffAdmin();
      allow create, update: if isStaffAdmin()
        && request.resource.data.staffId is string
        && request.resource.data.employeeId is string;
      allow delete: if isStaffAdmin();
    }

    match /staffPrivateNotes/{staffId} {
      allow read, create, update: if isStaffAdmin();
      allow delete: if false;
    }

    match /staffPrivateContacts/{staffId} {
      allow read: if isStaffAdmin();
      allow create, update: if isStaffAdmin()
        && request.resource.data.phone is string
        && request.resource.data.lineId is string
        && request.resource.data.email is string
        && request.resource.data.updatedByUid == request.auth.uid;
      allow delete: if false;
    }

    match /staffSettings/externalTools {
      allow read: if isOperationalStaff();
      allow create, update: if isStaffAdmin()
        && request.resource.data.keys().hasOnly(['groups', 'sidebarTextSize', 'revision', 'updatedAt', 'updatedByUid'])
        && request.resource.data.keys().hasAll(['groups', 'revision', 'updatedAt', 'updatedByUid'])
        && (!request.resource.data.keys().hasAny(['sidebarTextSize'])
          || request.resource.data.sidebarTextSize in ['small', 'normal', 'large'])
        && request.resource.data.groups is list
        && request.resource.data.groups.size() <= 10
        && request.resource.data.revision is string
        && request.resource.data.revision.size() > 0
        && request.resource.data.revision.size() <= 80
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedByUid == request.auth.uid;
      allow delete: if false;
    }

    match /staffSettings/packingRoomNotice {
      allow read: if isOperationalStaff();
      allow create, update: if isStaffAdmin()
        && request.resource.data.keys().hasOnly(['content', 'updatedAt', 'updatedByUid'])
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 5000
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedByUid == request.auth.uid;
      allow delete: if false;
    }

    match /staffDutyTypes/{dutyTypeId} {
      allow read: if isOperationalStaff();
      allow create, update: if isStaffAdmin()
        && request.resource.data.name is string
        && request.resource.data.active is bool;
      allow delete: if false;
    }

    // เวรประจำสัปดาห์ — ตารางตายตัวที่ทุกวันในสัปดาห์ยึดตาม
    match /staffWeeklyDuties/{weeklyDutyId} {
      allow read: if isOperationalStaff();
      allow create, update: if isStaffAdmin()
        && request.resource.data.keys().hasOnly([
          'weekday', 'staffId', 'dutyTypeId', 'note', 'updatedAt', 'updatedBy'
        ])
        && request.resource.data.weekday is int
        && request.resource.data.weekday >= 0
        && request.resource.data.weekday <= 6
        && request.resource.data.staffId is string
        && staffExists(request.resource.data.staffId)
        && request.resource.data.dutyTypeId is string
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 200;
      allow delete: if isStaffAdmin();
    }

    // การเปลี่ยนแปลงเฉพาะวัน — ผูกกับวันที่ ไม่แตะตารางเวรประจำ
    // staffId เป็นสตริงว่างได้ หมายถึงงดเวรนั้นเฉพาะวันนั้น
    match /staffDutyOverrides/{overrideId} {
      allow read: if isOperationalStaff();
      allow create, update: if isStaffAdmin()
        && request.resource.data.keys().hasOnly([
          'date', 'weeklyDutyId', 'staffId', 'note', 'updatedAt', 'updatedByUid'
        ])
        && request.resource.data.date is string
        && request.resource.data.date.size() == 10
        && request.resource.data.weeklyDutyId is string
        && overrideId == request.resource.data.date + '__' + request.resource.data.weeklyDutyId
        && request.resource.data.staffId is string
        // สตริงว่าง = งดเวรวันนั้น จึงต้องยกเว้นจากการตรวจว่ามีพนักงานจริง
        && (request.resource.data.staffId == ''
            || staffExists(request.resource.data.staffId))
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 200
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedByUid == request.auth.uid;
      allow delete: if isStaffAdmin();
    }

    match /staffDailyAssignments/{assignmentId} {
      allow read: if isOperationalStaff();
      allow create, update: if isStaffAdmin()
        && request.resource.data.date is string
        && request.resource.data.staffId is string
        && request.resource.data.dutyTypeId is string;
      allow delete: if isStaffAdmin();
    }

    match /staffDailyStatuses/{statusId} {
      allow read: if isOperationalStaff();
      allow create, update: if isStaffAdmin()
        && request.resource.data.keys().hasOnly([
          'date', 'staffId', 'status', 'updatedAt', 'updatedByUid'
        ])
        && request.resource.data.date is string
        && request.resource.data.date.size() == 10
        && request.resource.data.staffId is string
        && request.resource.data.status in ['leave', 'off', 'outside']
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedByUid == request.auth.uid;
      allow delete: if isStaffAdmin();
    }

    match /staffDailyLeads/{date} {
      allow read: if isOperationalStaff();
      allow create, update: if isStaffAdmin()
        && request.resource.data.keys().hasOnly([
          'date', 'staffId', 'updatedAt', 'updatedByUid'
        ])
        && request.resource.data.date == date
        && request.resource.data.date.size() == 10
        && request.resource.data.staffId is string
        && get(/databases/$(database)/documents/staffMembers/$(request.resource.data.staffId)).data.position in ['checker', 'packer']
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedByUid == request.auth.uid;
      allow delete: if isStaffAdmin();
    }

    // คลัง SOP เป็นข้อมูลแก้ไขได้ของ Admin; ฉบับเผยแพร่แยกเก็บและห้ามแก้ย้อนหลัง
    match /staffSops/{sopId} {
      allow read: if isOperationalStaff();
      allow create, update: if isStaffAdmin()
        && request.resource.data.keys().hasOnly([
          'title', 'description', 'draftSteps', 'publishedTitle', 'publishedDescription', 'active', 'latestVersion',
          'createdAt', 'createdByUid', 'updatedAt', 'updatedByUid'
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 1000
        && request.resource.data.draftSteps is list
        && request.resource.data.draftSteps.size() > 0
        && request.resource.data.draftSteps.size() <= 30
        && (!request.resource.data.keys().hasAny(['publishedTitle'])
          || (request.resource.data.publishedTitle is string
            && request.resource.data.publishedTitle.size() <= 120))
        && (!request.resource.data.keys().hasAny(['publishedDescription'])
          || (request.resource.data.publishedDescription is string
            && request.resource.data.publishedDescription.size() <= 1000))
        && request.resource.data.active is bool
        && request.resource.data.latestVersion is int
        && request.resource.data.latestVersion >= 0
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedByUid == request.auth.uid;
      allow delete: if false;
    }

    match /staffSopVersions/{versionId} {
      allow read: if isOperationalStaff();
      allow create: if isStaffAdmin()
        && request.resource.data.keys().hasOnly([
          'sopId', 'version', 'title', 'description', 'steps',
          'publishedAt', 'publishedByUid'
        ])
        && request.resource.data.sopId is string
        && request.resource.data.version is int
        && request.resource.data.version > 0
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 1000
        && request.resource.data.steps is list
        && request.resource.data.steps.size() > 0
        && request.resource.data.steps.size() <= 30
        && request.resource.data.publishedAt == request.time
        && request.resource.data.publishedByUid == request.auth.uid;
      allow update, delete: if false;
    }

    // แผนรายวันเก็บตัวนับลำดับ เพื่อออกเลขงานแบบ atomic เมื่อมี Admin หลายคนสร้างพร้อมกัน
    match /staffWorkPlans/{date} {
      allow read: if isOperationalStaff();
      allow create, update: if isStaffAdmin()
        && request.resource.data.keys().hasOnly([
          'date', 'taskCount', 'nextSequence', 'createdAt', 'createdByUid', 'updatedAt', 'updatedByUid'
        ])
        && request.resource.data.date == date
        && request.resource.data.date.size() == 10
        && request.resource.data.taskCount is int
        && request.resource.data.taskCount >= 0
        && request.resource.data.taskCount <= 200
        && request.resource.data.nextSequence is int
        && request.resource.data.nextSequence >= 1
        && request.resource.data.nextSequence <= 201
        && ((!exists(/databases/$(database)/documents/staffWorkPlans/$(date))
          && request.resource.data.createdAt == request.time
          && request.resource.data.createdByUid == request.auth.uid)
          || (exists(/databases/$(database)/documents/staffWorkPlans/$(date))
            && request.resource.data.createdAt == resource.data.createdAt
            && request.resource.data.createdByUid == resource.data.createdByUid))
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedByUid == request.auth.uid;
      allow delete: if false;
    }

    // แต่ละงานเก็บภาพ SOP ณ เวอร์ชันที่สร้าง จึงไม่เปลี่ยนเมื่อมีการเผยแพร่เวอร์ชันใหม่
    match /staffWorkPlanTasks/{taskId} {
      allow read: if isOperationalStaff();
      allow create, update: if isStaffAdmin()
        && request.resource.data.keys().hasOnly([
          'date', 'sequence', 'targetTime', 'assignedStaffIds', 'dependsOnTaskIds', 'sopId',
          'sopVersion', 'sopSnapshot', 'stepProgress', 'status', 'note',
          'createdAt', 'createdByUid', 'updatedAt', 'updatedByUid'
        ])
        && request.resource.data.date is string
        && request.resource.data.date.size() == 10
        && request.resource.data.sequence is int
        && request.resource.data.sequence >= 1
        && request.resource.data.targetTime is string
        && request.resource.data.assignedStaffIds is list
        && request.resource.data.assignedStaffIds.size() > 0
        && request.resource.data.assignedStaffIds.size() <= 50
        && request.resource.data.dependsOnTaskIds is list
        && request.resource.data.dependsOnTaskIds.size() <= 20
        && request.resource.data.sopId is string
        && request.resource.data.sopVersion is int
        && request.resource.data.sopVersion > 0
        && request.resource.data.sopSnapshot is map
        && request.resource.data.sopSnapshot.steps is list
        && request.resource.data.sopSnapshot.steps.size() > 0
        && request.resource.data.sopSnapshot.steps.size() <= 30
        && request.resource.data.stepProgress is map
        && request.resource.data.stepProgress.keys().size() <= 30
        && request.resource.data.status in ['planned', 'in_progress', 'blocked', 'completed']
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 500
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedByUid == request.auth.uid
        && existsAfter(/databases/$(database)/documents/staffWorkPlans/$(request.resource.data.date))
        && getAfter(/databases/$(database)/documents/staffWorkPlans/$(request.resource.data.date)).data.date
          == request.resource.data.date
        && getAfter(/databases/$(database)/documents/staffWorkPlans/$(request.resource.data.date)).data.nextSequence
          > request.resource.data.sequence;
      allow delete: if isStaffAdmin();
    }

    // ประวัติความคืบหน้าเพิ่มได้อย่างเดียว เพื่อเก็บผู้บันทึกและการเปลี่ยนสถานะย้อนหลัง
    match /staffWorkPlanEvents/{eventId} {
      allow read: if isOperationalStaff();
      allow create: if isStaffAdmin()
        && request.resource.data.keys().hasOnly([
          'date', 'taskId', 'type', 'status', 'actorUid', 'createdAt', 'stepId', 'completed'
        ])
        && request.resource.data.date is string
        && request.resource.data.date.size() == 10
        && request.resource.data.taskId is string
        && request.resource.data.type in ['step_progress', 'status_change', 'task_deleted']
        && request.resource.data.status in ['planned', 'in_progress', 'blocked', 'completed']
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && ((request.resource.data.type == 'step_progress'
          && request.resource.data.stepId is string
          && request.resource.data.completed is bool)
          || (request.resource.data.type in ['status_change', 'task_deleted']
            && !request.resource.data.keys().hasAny(['stepId', 'completed'])));
      allow update, delete: if false;
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.uid == request.auth.uid;
    }

    match /scanEvents/{eventId} {
      allow read: if isOperationalStaff();
      allow create: if isOperationalStaff()
        && request.resource.data.keys().hasOnly([
          'type', 'code', 'normalizedCode', 'courier', 'status', 'date', 'time',
          'packer', 'note', 'sheetUrl', 'merged', 'user', 'createdAt'
        ])
        && request.resource.data.code is string
        && request.resource.data.code.size() >= 8
        && request.resource.data.normalizedCode is string
        && request.resource.data.normalizedCode.size() >= 8
        && request.resource.data.courier is string
        && request.resource.data.type in ['packer', 'admin'];
      allow update, delete: if false;
    }

    match /orders/{orderId} {
      allow read: if isOperationalStaff();
      allow create: if isOperationalStaff()
        && request.resource.data.code is string
        && request.resource.data.code.size() >= 8
        && request.resource.data.normalizedCode is string
        && request.resource.data.normalizedCode.size() >= 8
        && request.resource.data.courier is string
        && request.resource.data.date is string
        && request.resource.data.status in [
          'pending',
          'packer_scanned',
          'matched',
          'issue',
          'cancelled',
          'damaged',
          'returned'
        ]
        && request.resource.data.sheetSyncStatus in [
          'pending',
          'writing',
          'verified',
          'synced',
          'failed'
        ];
      allow delete: if false;
      allow update: if isOperationalStaff()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'packer', 'note', 'admin', 'packerScan', 'sheetSyncStatus',
          'sheetSyncError', 'sheetSyncAttemptId', 'sheetSyncStartedAtIso',
          'sheetSyncedAt', 'sheetVerifiedAt', 'sheetVerifiedAtIso', 'sheetResultStatus',
          'sheetUrl', 'updatedAt', 'updatedAtIso', 'user',
          'marketplaceOrderId', 'marketplaceSkus', 'marketplaceItems',
          'importedFromSheet', 'importedAt'
        ])
        && request.resource.data.code == resource.data.code
        && request.resource.data.normalizedCode == resource.data.normalizedCode
        && request.resource.data.courier == resource.data.courier
        && request.resource.data.date == resource.data.date
        && request.resource.data.code.size() >= 8
        && request.resource.data.normalizedCode.size() >= 8
        && request.resource.data.status in [
          'pending', 'packer_scanned', 'matched', 'issue', 'cancelled', 'damaged', 'returned'
        ]
        && request.resource.data.sheetSyncStatus in [
          'pending', 'writing', 'verified', 'synced', 'failed'
        ]
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'marketplaceOrderId', 'marketplaceSkus', 'marketplaceItems'
        ])
          || (
            request.resource.data.marketplaceOrderId is string
            && request.resource.data.marketplaceSkus is list
            && request.resource.data.marketplaceSkus.size() <= 100
            && request.resource.data.marketplaceItems is list
            && request.resource.data.marketplaceItems.size() <= 100
          ));
    }

    // Immutable operational history for scans and Sheet outbox transitions. It records
    // the actor and timestamp at the same time as the order transaction, so diagnosis does
    // not depend on a mutable "latest status" field.
    match /orderAuditEvents/{eventId} {
      allow read: if isOperationalStaff();
      allow create: if isOperationalStaff()
        && request.resource.data.keys().hasOnly([
          'orderId', 'type', 'code', 'courier', 'actor', 'detail', 'createdAt', 'createdAtIso'
        ])
        && request.resource.data.orderId is string
        && request.resource.data.type in [
          'admin_scanned', 'packer_scanned', 'sheet_sync_pending', 'sheet_sync_writing',
          'sheet_sync_verified', 'sheet_sync_failed', 'status_repaired'
        ]
        && request.resource.data.code is string
        && request.resource.data.courier is string
        && request.resource.data.actor.uid == request.auth.uid
        && request.resource.data.actor.email is string
        && request.resource.data.actor.name is string
        && request.resource.data.detail is map
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdAtIso is string;
      allow update, delete: if false;
    }

    match /syncStatus/{platform} {
      allow read: if isOperationalStaff();
      allow write: if false;
    }

    // กระดานกลางระหว่างเครื่องที่สแกนกับรีโมทบนมือถือ — ใบเดียวต่อโหมด ไม่ใช่คิวคำสั่ง
    // แยก packer กับ drive เพราะทั้งสองโหมดใช้ selectedCourier ตัวเดียวกัน ถ้ารวมกระดานกัน
    // ห้องแพ็คจะเปลี่ยนขนส่งให้เครื่อง Admin ที่กำลังรับเข้า Drive อยู่โดยไม่มีใครรู้
    // เขียนได้ทุกคนที่เป็นพนักงานปฏิบัติการ (ไม่ใช่แค่ Admin) เพราะคนแพ็คต้องกดเปลี่ยนเอง
    match /scanRemoteControl/{controlId} {
      allow read: if isOperationalStaff();
      allow create, update: if isOperationalStaff()
        && controlId in ['packer', 'drive']
        && request.resource.data.keys().hasOnly([
          'courier', 'packer', 'origin', 'updatedAt', 'updatedByUid'
        ])
        && request.resource.data.courier is string
        && request.resource.data.courier.size() > 0
        && request.resource.data.courier.size() <= 80
        && request.resource.data.packer is string
        && request.resource.data.packer.size() > 0
        && request.resource.data.packer.size() <= 80
        && request.resource.data.origin in ['remote', 'desktop']
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedByUid == request.auth.uid;
      allow delete: if false;
    }

    match /couriers/{courierId} {
      allow read: if isOperationalStaff();
      allow create, update: if isStaffAdmin()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80;
      allow delete: if false;
    }
  }
}
